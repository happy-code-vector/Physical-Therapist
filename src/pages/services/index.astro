---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
import '../../styles/services.css';

const SITE = Astro.site ?? new URL('https://faastpt.com');
const hubURL = new URL('/services/', SITE).href;

const blurb = (hero: string) => (hero.split('. ')[0] || hero) + '.';
const conditions = services.filter((s) => s.category === 'condition');
const pathways = services.filter((s) => s.category === 'pathway');

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Physical therapy services - FAAST Physical Therapy',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: s.title,
    url: new URL('/services/' + s.slug + '/', SITE).href,
  })),
};

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://faastpt.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: hubURL },
  ],
};
---
<BaseLayout
  title="Physical Therapy Services | FAAST Physical Therapy"
  description="Physical therapy services from FAAST Physical Therapy in Floral Park & Carle Place, NY - back and sciatica, neck and whiplash, shoulder, knee, post-surgical rehab, No-Fault and Workers' Comp. No referral needed."
  ogTitle="Physical Therapy Services - FAAST Physical Therapy">

  <Fragment slot="schema">
    <script type="application/ld+json" set:html={JSON.stringify(itemList)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <!-- HERO -->
  <section class="svc-hero">
    <div class="svc-hero__inner">
      <p class="svc-hero__eyebrow">What we treat</p>
      <h1 class="svc-hero__title">Physical therapy services in <span class="mark">Floral Park &amp; Carle Place</span>, NY</h1>
      <p class="svc-hero__sub">
        One-on-one care with Dr. Asim Iftikhar for the conditions that slow people down - backs,
        necks, shoulders, knees, and more - plus New York No-Fault and Workers' Comp pathways.
        No referral needed to start.
      </p>
      <div class="svc-hero__cta">
        <a class="btn btn-copper-solid" href="/#book">Book an appointment</a>
        <a class="btn btn-ghost" href="tel:+15167896322">(516) 789-6322</a>
      </div>
    </div>
  </section>

  <!-- CONDITIONS -->
  <section class="section" aria-labelledby="hub-cond-title">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">Conditions</p>
        <h2 class="section-title" id="hub-cond-title">What we treat, hands-on.</h2>
        <p class="section-intro">Every session is one-on-one with Dr. Iftikhar. Pick what hurts - or call us, odds are we treat it.</p>
      </header>
      <div class="svc-hub">
        {conditions.map((s) => (
          <a class="svc-card" href={`/services/${s.slug}/`}>
            <h3>{s.title}</h3>
            <p>{blurb(s.hero)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PATHWAYS -->
  <section class="section section-tint" aria-labelledby="hub-path-title">
    <div class="container">
      <header class="section-head">
        <p class="section-eyebrow">Insurance & claims</p>
        <h2 class="section-title" id="hub-path-title">Auto injuries and work injuries.</h2>
        <p class="section-intro">We handle the No-Fault and Workers' Comp paperwork and authorizations so you can focus on healing.</p>
      </header>
      <div class="svc-hub">
        {pathways.map((s) => (
          <a class="svc-card" href={`/services/${s.slug}/`}>
            <h3>{s.title}</h3>
            <p>{blurb(s.hero)}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
